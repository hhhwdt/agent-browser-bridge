{
  "manifest_version": 3,
  "default_locale": "en",
  "name": "__MSG_appName__",
  "version": "1.8.0",
  "key": "",
  "description": "__MSG_appDesc__",
  "permissions": [
    "tabs",
    "scripting",
    "storage",
    "alarms",
    "downloads"
  ],
  "host_permissions": [
    "http://127.0.0.1:18777/*",
    "http://localhost:18777/*"
  ],
  "optional_permissions": [
    "cookies",
    "debugger"
  ],
  "optional_host_permissions": [
    "*://*/*"
  ],
  "background": {
    "service_worker": "sw/background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Agent Browser Bridge"
  }
}
